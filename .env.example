# Set these in your shell. DocSync deliberately does not load repository .env files.
DOCSYNC_DATA_DIR=.docsync
DOCSYNC_OLLAMA_URL=http://127.0.0.1:11434
DOCSYNC_QDRANT_URL=http://127.0.0.1:6333
# npm defaults to embedded storage; Python-source mode defaults to server.
# DOCSYNC_QDRANT_MODE=embedded
DOCSYNC_MODEL=qwen2.5-coder:3b
DOCSYNC_EMBED_MODEL=nomic-embed-text:v1.5
# Only used for projects whose cloud consent is explicitly enabled in the CLI or UI.
GEMINI_API_KEY=
DOCSYNC_GEMINI_MODEL=gemini-3.5-flash-lite
